{
  "name": "zelika-site",
  "compatibility_date": "2026-06-17",
  "main": "worker.js",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/quiz", "/uk", "/en", "/uk/*", "/en/*", "/prywatnosc", "/robots.txt", "/sitemap.xml", "/llms.txt"]
  }
}
