{
  "name": "zelika-site",
  "compatibility_date": "2026-06-17",
  "main": "worker.js",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Воркер першим для ВСІХ запитів: www→apex (301) і канонічні 301 мають діяти й для
    // статики; брендована 404. Статика далі — через env.ASSETS (html_handling за замовч.
    // auto-trailing-slash; його 307 воркер переписує на 301), _headers застосовуються.
    "run_worker_first": true
  }
}
